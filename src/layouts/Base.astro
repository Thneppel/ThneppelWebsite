---
// Layout único do site: portfólio, blog e páginas institucionais usam este.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { alternatePath, getLocale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Cabeçalho transparente sobre a abertura (home). */
  headerOverlay?: boolean;
  /** "article" nos posts do blog (Open Graph). */
  type?: 'website' | 'article';
}

const { title, description = '', image: pageImage, headerOverlay = false, type = 'website' } = Astro.props;
const locale = getLocale(Astro.currentLocale);
// Imagem de compartilhamento padrão (1200x630): a marca sobre fundo escuro, por idioma.
// Páginas com imagem própria (posts do blog) passam `image`.
const defaultImage = locale === 'pt-br' ? '/images/og-pt.jpg' : '/images/og-en.jpg';
const image = pageImage ?? defaultImage;
const alt = alternatePath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alt.locale} href={new URL(alt.path, Astro.site)} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Thneppel" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    {image === defaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content={locale === 'pt-br' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0a0d" />

    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Extras por página (feed RSS, dados estruturados etc.) -->
    <slot name="head" />
  </head>
  <body>
    <Header overlay={headerOverlay} />
    <main>
      <slot />
    </main>
    <Footer />
    <VideoPlayer />
  </body>
</html>
