---
import { alternatePath, getLocale, localePath, t } from '../i18n/ui';

interface Props {
  /** Transparente sobre a abertura da home; ganha fundo ao rolar. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const alt = alternatePath(Astro.url.pathname);
const home = localePath(locale, '/');

const links = [
  { href: `${home}#work`, label: t(locale, 'nav.work') },
  { href: `${home}#about`, label: t(locale, 'nav.about') },
  { href: localePath(locale, '/blog/'), label: t(locale, 'nav.blog') },
  { href: `${home}#contact`, label: t(locale, 'nav.contact') },
];
const langs = [
  { code: 'en', label: 'EN', href: locale === 'en' ? Astro.url.pathname : alt.path },
  { code: 'pt-br', label: 'BR', href: locale === 'pt-br' ? Astro.url.pathname : alt.path },
];
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a href={home} class="logo" aria-label="Thneppel">
      <span class="logo-mark" aria-hidden="true"></span>
    </a>

    <nav id="site-nav" aria-label="Principal">
      <ul class="links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
      <div class="langs" aria-label={t(locale, 'lang.label')}>
        {
          langs.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              <a
                href={l.href}
                hreflang={l.code}
                aria-current={l.code === locale ? 'true' : undefined}
              >
                {l.label}
              </a>
            </>
          ))
        }
      </div>
    </nav>

    <!-- O texto do botão fica digitando e apagando frases (só visual; o nome dele é fixo).
         O botão cresce e encolhe junto com o texto e "reage" a cada letra. -->
    <a href={`${home}#contact`} class="btn btn-primary cta" aria-label={t(locale, 'nav.cta')} data-typer-btn>
      <span class="typed" aria-hidden="true" data-typer={t(locale, 'nav.ctaPhrases')}>
        {t(locale, 'nav.ctaPhrases').split('|')[0]}
      </span>
    </a>

    <button class="toggle" aria-controls="site-nav" aria-expanded="false" aria-label={t(locale, 'nav.menu')}>
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  // Botão do menu: digita uma frase, espera, apaga e passa para a próxima.
  const TYPE_MS = 75; // por letra, digitando
  const ERASE_MS = 40; // por letra, apagando
  const HOLD_MS = 2200; // frase completa na tela
  const GAP_MS = 350; // botão vazio antes da próxima

  document.querySelectorAll<HTMLElement>('[data-typer]').forEach((out) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const btn = out.closest<HTMLElement>('[data-typer-btn]')!;
    const phrases = out.dataset.typer!.split('|').map((p) => Array.from(p));
    const bar = btn.parentElement!;
    const nav = bar.querySelector<HTMLElement>('nav');

    // Mede a largura que o botão teria com uma frase (cópia invisível do botão).
    const probe = btn.cloneNode(true) as HTMLElement;
    probe.removeAttribute('data-typer-btn');
    probe.setAttribute('aria-hidden', 'true');
    probe.tabIndex = -1;
    Object.assign(probe.style, { position: 'absolute', visibility: 'hidden', pointerEvents: 'none', left: '0', top: '0' });
    bar.append(probe);
    const probeText = probe.querySelector<HTMLElement>('[data-typer]')!;
    probeText.removeAttribute('data-typer');

    /** A frase cabe entre os links do menu e a borda? (no celular o botão fica escondido) */
    const fits = (chars: string[]) => {
      if (!nav || getComputedStyle(btn).display === 'none') return true;
      probeText.textContent = chars.join('');
      // 40px de folga: o chacoalhão aumenta o botão por um instante.
      const free = bar.getBoundingClientRect().right - nav.getBoundingClientRect().right - 40;
      return probe.getBoundingClientRect().width <= free;
    };

    /** Reinicia uma animação de CSS no botão (batidinha por letra, chacoalhão no fim). */
    const bump = (name: 'tick' | 'shake') => {
      btn.classList.remove('tick', 'shake');
      void btn.offsetWidth; // força o navegador a recomeçar a animação
      if (name === 'tick') btn.style.setProperty('--tilt', `${(Math.random() * 2 - 1) * 2.5}deg`);
      btn.classList.add(name);
    };
    let index = 0;

    // Ordem aleatória sem repetir: as frases saem de um "saco" embaralhado e só voltam
    // depois que todas passaram. A primeira de cada rodada nunca é a última da anterior.
    let bag: number[] = [];
    const refill = () => {
      bag = phrases.map((_, i) => i);
      for (let i = bag.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [bag[i], bag[j]] = [bag[j], bag[i]];
      }
      if (bag.length > 1 && bag[bag.length - 1] === index) bag.unshift(bag.pop()!);
    };
    const nextIndex = () => {
      if (!bag.length) refill();
      return bag.pop()!;
    };
    // A primeira frase (já escrita no HTML) conta como vista nesta rodada.
    refill();
    bag = bag.filter((i) => i !== 0);
    let length = phrases[0].length;
    let typing = false;

    const step = () => {
      const chars = phrases[index];
      if (typing) {
        length++;
        out.textContent = chars.slice(0, length).join('');
        if (length < chars.length) {
          bump('tick');
          return setTimeout(step, TYPE_MS);
        }
        typing = false;
        bump('shake');
        return setTimeout(step, HOLD_MS);
      }
      length--;
      out.textContent = chars.slice(0, Math.max(0, length)).join('');
      if (length > 0) return setTimeout(step, ERASE_MS);
      // Próxima frase do saco que caiba na tela (em telas estreitas as longas são puladas).
      for (let tries = 0; tries < phrases.length * 2; tries++) {
        index = nextIndex();
        if (fits(phrases[index])) break;
      }
      typing = true;
      return setTimeout(step, GAP_MS);
    };
    setTimeout(step, HOLD_MS);
  });

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.toggle');

  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  toggle?.addEventListener('click', () => {
    const open = header!.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  header?.querySelectorAll('nav a').forEach((a) =>
    a.addEventListener('click', () => {
      header.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 10, 13, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  /* Home: flutua sobre a abertura, sem fundo */
  .site-header.overlay {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
  }

  .site-header.overlay.scrolled,
  .site-header.overlay.open {
    background: rgba(11, 10, 13, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-color: var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 72px;
  }

  /* Logo como máscara: assume a cor do menu (vinho sobre as listras, creme no resto) */
  .logo-mark {
    display: block;
    height: 20px;
    aspect-ratio: 377 / 40;
    background: var(--nav-color, var(--cream));
    -webkit-mask: url('/images/logo.png') center / contain no-repeat;
    mask: url('/images/logo.png') center / contain no-repeat;
    transition: background-color 0.3s var(--ease);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin: 0 auto;
  }

  .links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .links a,
  .langs a {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--nav-color, var(--cream));
  }

  .links a:hover {
    color: var(--accent);
  }

  .langs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--nav-color, var(--cream));
  }

  .langs span {
    opacity: 0.4;
  }

  .langs a:not([aria-current]) {
    opacity: 0.45;
  }

  .langs a:hover {
    opacity: 1;
  }

  .cta {
    padding: 0.7rem 1.2rem;
    font-size: 0.7rem;
  }

  /* O botão acompanha o texto, mas nunca some de todo quando a frase está apagada */
  .cta {
    min-width: 2.75rem;
    white-space: nowrap;
  }

  /* Batidinha a cada letra digitada, levemente torta (--tilt muda a cada letra) */
  .cta.tick {
    animation: cta-tick 0.14s ease-out;
  }

  @keyframes cta-tick {
    40% {
      transform: scale(1.06) rotate(var(--tilt, 0deg));
    }
  }

  /* Chacoalhão quando a frase termina */
  .cta.shake {
    animation: cta-shake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes cta-shake {
    15% {
      transform: translateX(-3px) rotate(-4deg) scale(1.08);
    }
    35% {
      transform: translateX(3px) rotate(3deg);
    }
    55% {
      transform: translateX(-2px) rotate(-2deg);
    }
    75% {
      transform: translateX(1px) rotate(1deg);
    }
  }

  .typed:empty::before {
    content: '\200b';
  }

  .toggle {
    display: none;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    margin-left: auto;
  }

  .toggle span {
    display: block;
    height: 2px;
    background: var(--nav-color, var(--cream));
    transition: transform 0.3s var(--ease);
  }

  .open .toggle span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .open .toggle span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* Desktop: logo | links | botão em três colunas. As laterais têm a mesma largura,
     então os links ficam parados no centro enquanto o botão cresce e encolhe. */
  @media (min-width: 901px) {
    .bar {
      display: grid;
      /* minmax(0, …): o botão nunca alarga a coluna, então os links não se mexem */
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .logo {
      justify-self: start;
    }

    nav {
      margin: 0;
    }

    .cta {
      justify-self: end;
    }
  }

  @media (max-width: 900px) {
    .toggle {
      display: flex;
    }

    .cta {
      display: none;
    }

    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: rgba(11, 10, 13, 0.97);
      border-bottom: 1px solid var(--border);
    }

    .open nav {
      display: flex;
    }

    .links {
      flex-direction: column;
      gap: 1.25rem;
    }

    .links a,
    .langs a {
      font-size: 0.85rem;
    }
  }
</style>
