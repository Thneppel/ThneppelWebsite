---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getLocale, localePath } from '../i18n/ui';
import type { Project } from '../lib/projects';
import { parseYouTube } from '../lib/youtube';

/** Atributos para o vídeo abrir no player do site (e ter prévia, se `preview`). */
function ytAttrs(url: string | undefined, label: string, preview = false) {
  const yt = parseYouTube(url);
  if (!yt) return {};
  return {
    'data-yt': yt.id,
    'data-yt-short': yt.short ? '' : undefined,
    'data-yt-preview': preview ? '' : undefined,
    'aria-label': label,
  };
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const locale = getLocale(Astro.currentLocale);
const { title, category, cover, watch, media, layout } = project.data;

const copy = {
  en: { back: 'All work', watch: 'Watch project', play: 'Play' },
  'pt-br': { back: 'Todos os trabalhos', watch: 'Assistir projeto', play: 'Assistir' },
}[locale];

const description = project.body?.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').slice(0, 155).trim();
---

<Base title={`${title} | Thiago Neppel`} description={description}>
  <article>
    <header class="container head">
      <a href={`${localePath(locale, '/')}#work`} class="back">← {copy.back}</a>
      <span class="eyebrow">{category}</span>
      <h1 class="display-title">{title}</h1>
      <div class="body">
        <Content />
      </div>
      {
        watch && (
          <a href={watch} class="btn btn-primary" target="_blank" rel="noopener" {...ytAttrs(watch, title)}>
            {copy.watch} ▶
          </a>
        )
      }
    </header>

    {
      media.length > 0 && (
        <ul class:list={['container', 'gallery', { vertical: layout === 'vertical' }]}>
          {media.map((m) => {
            const img = (
              <Image
                src={m.image}
                alt={m.title ?? title}
                widths={[400, 640, 800]}
                sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px"
              />
            );
            return (
              <li>
                {m.video ? (
                  <a
                    href={m.video}
                    target="_blank"
                    rel="noopener"
                    class="tile"
                    {...ytAttrs(m.video, m.title ?? title, true)}
                  >
                    {img}
                    <span class="play" aria-hidden="true">▶</span>
                    {m.title && <span class="caption">{m.title}</span>}
                    <span class="sr-only">{copy.play}</span>
                  </a>
                ) : (
                  <div class="tile">{img}</div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    {
      media.length === 0 && (
        <div class="container">
          <Image src={cover} alt={title} widths={[800, 1240]} sizes="100vw" class="cover" />
        </div>
      )
    }
  </article>
</Base>

<style>
  article {
    padding: clamp(3rem, 7vw, 5rem) 0 var(--section-pad);
  }

  .head {
    max-width: calc(48rem + 2 * var(--gutter));
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .back:hover {
    color: var(--accent);
  }

  .eyebrow {
    display: flex;
    margin-bottom: 1.25rem;
  }

  .display-title {
    margin-bottom: 1.75rem;
  }

  .body {
    font-size: 1.08rem;
    margin-bottom: 2rem;
  }

  .body :global(p) {
    margin-bottom: 1rem;
  }

  .body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  .gallery {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .gallery.vertical {
    grid-template-columns: repeat(5, 1fr);
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .vertical .tile {
    aspect-ratio: 9 / 16;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  a.tile:hover :global(img) {
    transform: scale(1.04);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1rem;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2rem 0.9rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    background: linear-gradient(180deg, transparent, rgba(11, 10, 13, 0.92));
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }

  a.tile:hover .play,
  a.tile:focus-visible .play {
    opacity: 1;
    transform: none;
  }

  /* Com a prévia tocando, o ícone de play sai de cima do vídeo */
  .tile:has(:global(.yt-preview.ready)) .play {
    opacity: 0 !important;
  }

  a.tile:hover .caption,
  a.tile:focus-visible .caption {
    opacity: 1;
  }

  @media (hover: none) {
    .play,
    .caption {
      opacity: 1;
      transform: none;
    }
  }

  .cover {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery.vertical {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery.vertical {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
