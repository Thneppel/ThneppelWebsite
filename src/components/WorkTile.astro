---
// Miniatura de uma peça: abre o vídeo (ou a página do projeto, se for uma arte sem vídeo).
import { Image } from 'astro:assets';
import type { Piece } from '../lib/projects';

interface Props {
  piece: Piece;
  /** Mostra o nome do cliente (útil nos Destaques, que misturam projetos). */
  showClient?: boolean;
  /** Força formato horizontal mesmo para peças verticais (grades mistas). */
  landscape?: boolean;
  /** Só a imagem, sem título embaixo (o nome continua para leitores de tela). */
  bare?: boolean;
  /** Galeria larga (Destaques): imagens maiores. */
  large?: boolean;
}

const { piece, showClient = false, landscape = false, bare = false, large = false } = Astro.props;
const vertical = piece.vertical && !landscape;
const widths = large ? [480, 800, 1200] : vertical ? [240, 400] : [400, 640];
const sizes = large
  ? '(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw'
  : vertical
    ? '(max-width: 560px) 50vw, 240px'
    : '(max-width: 560px) 100vw, (max-width: 900px) 50vw, 300px';
---

<a
  href={piece.href}
  class:list={['tile', { vertical }]}
  {...(piece.external ? { target: '_blank', rel: 'noopener' } : {})}
  {...(piece.youtube
    ? {
        'data-yt': piece.youtube.id,
        'data-yt-short': piece.youtube.short ? '' : undefined,
        'data-yt-preview': '',
        'aria-label': bare ? `${piece.client}: ${piece.title}` : piece.title,
      }
    : {})}
>
  <span class="frame" data-preview-host>
    <Image
      src={piece.image}
      alt={piece.title}
      widths={widths}
      sizes={sizes}
      loading="lazy"
    />
    {piece.isVideo && <span class="play" aria-hidden="true">▶</span>}
  </span>
  {
    !bare && (
      <span class="caption">
        {showClient && <span class="client">{piece.client}</span>}
        <span class="title">{piece.title}</span>
      </span>
    )
  }
</a>

<style>
  .tile {
    display: grid;
    gap: 0.6rem;
  }

  .frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .vertical .frame {
    aspect-ratio: 9 / 16;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.85rem;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .caption {
    display: grid;
    gap: 0.15rem;
  }

  .client {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s var(--ease);
  }

  .tile:hover .frame :global(img),
  .tile:focus-visible .frame :global(img) {
    transform: scale(1.04);
  }

  .tile:hover .play,
  .tile:focus-visible .play {
    opacity: 1;
    transform: none;
  }

  /* Com a prévia tocando, o ícone de play sai de cima do vídeo */
  .frame:has(:global(.yt-preview.ready)) .play {
    opacity: 0 !important;
  }

  .tile:hover .title {
    color: var(--cream);
  }
</style>
