---
import { Image } from 'astro:assets';
import { getLocale, t } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';
import { parseYouTube } from '../../lib/youtube';

const locale = getLocale(Astro.currentLocale);
const product = (await getProjects(locale)).find((p) => p.data.group === 'product');
// Vídeo do campo `watch`: a thumb abre no player do site e toca uma prévia ao passar o mouse.
const video = parseYouTube(product?.data.watch);
---

{
  product && (
    <section class="product" aria-labelledby="product-title">
      <div class="container grid">
        <div class="art">
          {video ? (
            <a
              href={`https://www.youtube.com/watch?v=${video.id}`}
              class="thumb"
              target="_blank"
              rel="noopener"
              data-yt={video.id}
              data-yt-preview
              aria-label={t(locale, 'product.watch')}
            >
              <span class="frame" data-preview-host>
                <Image
                  src={product.data.cover}
                  alt={product.data.title}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 900px) 100vw, 46vw"
                />
                <span class="play" aria-hidden="true">▶</span>
              </span>
            </a>
          ) : (
            <span class="frame">
              <Image
                src={product.data.cover}
                alt={product.data.title}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) 100vw, 46vw"
              />
            </span>
          )}
          <span class="sticker">{t(locale, 'product.sticker')}</span>
        </div>

        <div class="text">
          <span class="eyebrow">{t(locale, 'product.eyebrow')}</span>
          <h2 id="product-title" class="display-title">{product.data.title}</h2>
          <p>{t(locale, 'product.text')}</p>
          <a href={product.data.link} class="btn btn-primary" target="_blank" rel="noopener">
            {t(locale, 'product.cta')} ↗
          </a>
          <p class="note">{t(locale, 'product.note')}</p>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Cores do MySoundLib (mysoundlib.com): verde sobre grafite.
     Os tokens são trocados só aqui, então eyebrow, botão e foco já seguem o verde. */
  .product {
    --accent: #1dcd9f;
    --accent-hover: #25e0b0;
    --accent-soft: rgba(29, 205, 159, 0.12);
    --text-muted: #a3a3a3;
    --border: rgba(255, 255, 255, 0.08);
    --msl-bg: #1c1c1c;
    --msl-bg-darker: #161616;
    --msl-ink: #1c1c1c;

    padding: var(--section-pad) 0;
    background:
      radial-gradient(60% 80% at 20% 50%, rgba(29, 205, 159, 0.12), transparent 70%),
      linear-gradient(180deg, var(--msl-bg) 0%, var(--msl-bg-darker) 100%);
    border-top: 1px solid rgba(29, 205, 159, 0.3);
  }

  /* Botão verde com texto escuro, como no site do MySoundLib */
  .btn-primary {
    color: var(--msl-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .art {
    position: relative;
  }

  /* Moldura 16:9 (a prévia do YouTube toca aqui dentro) */
  .frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--msl-bg-darker);
    box-shadow: 0 30px 80px rgba(29, 205, 159, 0.18);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  /* Play igual ao dos outros vídeos: só aparece no hover */
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--msl-ink);
    font-size: 0.85rem;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .thumb:hover .play,
  .thumb:focus-visible .play {
    opacity: 1;
    transform: none;
  }

  /* Com a prévia tocando, o play sai de cima do vídeo */
  .frame:has(:global(.yt-preview.ready)) .play {
    opacity: 0 !important;
  }

  .thumb:hover .frame :global(img),
  .thumb:focus-visible .frame :global(img) {
    transform: scale(1.03);
  }


  .sticker {
    position: absolute;
    right: -0.75rem;
    bottom: -1rem;
    padding: 0.7rem 1.1rem;
    background: var(--accent);
    color: var(--msl-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 10px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
    transform: rotate(-6deg);
  }

  .eyebrow {
    margin-bottom: 1.5rem;
  }

  .display-title {
    margin-bottom: 1.75rem;
  }

  .text > p {
    font-size: 1.1rem;
    max-width: 32rem;
    margin-bottom: 2rem;
  }

  .text > .note {
    margin: 1.5rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .sticker {
      right: 0.5rem;
    }
  }
</style>
