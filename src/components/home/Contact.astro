---
import { getLocale, t } from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale);

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/thneppel', icon: 'instagram' },
  { label: 'Twitter / X', href: 'https://twitter.com/Thneppel', icon: 'x' },
  { label: 'Discord', href: 'https://discord.com/users/204272847353413632', icon: 'discord' },
];
const email = 'contact@thneppel.com.br';
---

<section id="contact" class="contact">
  <div class="container grid">
    <div class="text">
      <span class="eyebrow">{t(locale, 'contact.eyebrow')}</span>
      <h2 class="display-title">
        {t(locale, 'contact.title')}
        <span class="accent">{t(locale, 'contact.titleAccent')}</span>
      </h2>
      <p>{t(locale, 'contact.text')}</p>

      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                <span class="icon" aria-hidden="true">
                  {s.icon === 'discord' ? (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M19.27 5.33A16.6 16.6 0 0 0 15.1 4l-.2.4a15.3 15.3 0 0 1 3.7 1.8 13.6 13.6 0 0 0-11.2 0A15.3 15.3 0 0 1 11.1 4.4L10.9 4a16.6 16.6 0 0 0-4.17 1.33C4.1 9.24 3.38 13.06 3.74 16.82A16.8 16.8 0 0 0 8.84 19.4l1.1-1.5a10.8 10.8 0 0 1-1.73-.84l.42-.33a11.9 11.9 0 0 0 10.74 0l.42.33c-.55.33-1.13.61-1.73.84l1.1 1.5a16.8 16.8 0 0 0 5.1-2.58c.42-4.36-.72-8.14-3-11.49ZM9.68 14.5c-1 0-1.83-.92-1.83-2.05s.81-2.05 1.83-2.05 1.84.93 1.83 2.05c0 1.13-.81 2.05-1.83 2.05Zm4.64 0c-1 0-1.83-.92-1.83-2.05s.81-2.05 1.83-2.05 1.84.93 1.83 2.05c0 1.13-.81 2.05-1.83 2.05Z" />
                  </svg>
                  ) : s.icon === 'instagram' ? (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                      <path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.17h1.7L7.4 4.74H5.58l11.09 14.43Z" />
                    </svg>
                  )}
                </span>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={`mailto:${email}`} class="email">{email}</a>
    </div>

    <form class="form" action="https://api.web3forms.com/submit" method="POST" data-contact-form>
      <input type="hidden" name="access_key" value="da9dbf03-3123-40f4-a0f7-826094278408" />
      <input type="hidden" name="subject" value="Novo contato - thneppel.com.br" />
      <input type="hidden" name="from_name" value="Site Thneppel" />
      <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" />

      <label>
        <span>{t(locale, 'contact.name')}</span>
        <input name="name" type="text" required placeholder={t(locale, 'contact.namePh')} autocomplete="name" />
      </label>
      <label>
        <span>{t(locale, 'contact.email')}</span>
        <input name="email" type="email" required placeholder={t(locale, 'contact.emailPh')} autocomplete="email" />
      </label>
      <label>
        <span>{t(locale, 'contact.message')}</span>
        <textarea name="message" rows="4" required placeholder={t(locale, 'contact.messagePh')}></textarea>
      </label>

      <button
        type="submit"
        class="btn btn-ghost"
        data-sending={t(locale, 'contact.sending')}
        data-ok={t(locale, 'contact.ok')}
        data-error={t(locale, 'contact.error')}
      >
        {t(locale, 'contact.send')} →
      </button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Envia pelo Web3Forms sem sair da página. Sem JavaScript, o formulário envia normalmente.
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const label = button.textContent;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending ?? '';
      status.textContent = '';
      status.dataset.state = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message);
        status.textContent = button.dataset.ok ?? '';
        status.dataset.state = 'ok';
        form.reset();
      } catch {
        status.textContent = button.dataset.error ?? '';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>

<style>
  .contact {
    position: relative;
    padding: var(--section-pad) 0;
    /* Preto do site com um brilho vermelho sangue atrás do formulário */
    background:
      radial-gradient(55% 75% at 78% 45%, rgba(220, 15, 42, 0.14), transparent 70%),
      linear-gradient(180deg, var(--bg) 0%, #110708 100%);
    border-top: 1px solid rgba(220, 15, 42, 0.22);
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .eyebrow {
    margin-bottom: 1.75rem;
  }

  .display-title {
    margin-bottom: 1.75rem;
  }

  .text > p {
    max-width: 28rem;
    color: rgba(247, 241, 234, 0.75);
  }

  .socials {
    list-style: none;
    display: grid;
    gap: 0.9rem;
    margin: 2.5rem 0 2rem;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 600;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 0.2s var(--ease);
  }

  .socials a:hover {
    color: var(--accent);
  }

  .socials a:hover .icon {
    border-color: var(--accent);
  }

  .email {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(247, 241, 234, 0.7);
    border-bottom: 1px solid currentColor;
  }

  .email:hover {
    color: var(--accent);
  }

  .form {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    padding-top: 0.5rem;
  }

  label {
    display: grid;
    gap: 0.5rem;
  }

  label span {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(247, 241, 234, 0.6);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(247, 241, 234, 0.25);
    color: var(--cream);
    font: inherit;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s var(--ease);
  }

  textarea {
    resize: vertical;
    min-height: 6rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(247, 241, 234, 0.45);
  }

  input:focus,
  textarea:focus {
    border-color: var(--accent);
  }

  .trap {
    display: none;
  }

  .form .btn {
    justify-self: start;
    background: rgba(11, 10, 13, 0.25);
  }

  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status {
    min-height: 1.5em;
    font-size: 0.9rem;
  }

  .status[data-state='ok'] {
    color: #6ee7a8;
  }

  .status[data-state='error'] {
    color: #ff6f7d;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
