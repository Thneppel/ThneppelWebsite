---
// Cartão de post na lista do blog. `feature`: versão grande (post mais recente).
import { Image } from 'astro:assets';
import { getLocale, t } from '../../i18n/ui';
import { formatDate, postHref, readingMinutes, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  feature?: boolean;
}

const { post, feature = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const href = postHref(post, locale);
---

<article class:list={['card', { feature }]}>
  <a href={href} class="cover" tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.cover}
      alt=""
      widths={feature ? [640, 960, 1280] : [480, 720, 960]}
      sizes={feature ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 700px) 100vw, 50vw'}
      loading={feature ? 'eager' : 'lazy'}
    />
  </a>
  <div class="body">
    {feature && <span class="latest">{t(locale, 'blog.latest')}</span>}
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post)} {t(locale, 'blog.minRead')}</span>
    </p>
    <h2 class="title"><a href={href}>{post.data.title}</a></h2>
    <p class="desc">{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.slice(0, feature ? 6 : 3).map((tag) => <li>#{tag}</li>)}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  /* O cartão inteiro é clicável (pelo link do título) */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card:hover .cover :global(img) {
    transform: scale(1.04);
  }

  .body {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .latest {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--cream);
    transition: color 0.2s var(--ease);
  }

  .card:hover .title {
    color: var(--accent);
  }

  .desc {
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Destaque: imagem grande ao lado do texto */
  .feature {
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .feature .title {
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .feature .desc {
    font-size: 1.05rem;
    -webkit-line-clamp: 4;
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
</style>
