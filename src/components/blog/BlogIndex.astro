---
// Página do blog: lista de posts (o mais recente em destaque) e filtro por tag.
// Com `tag`, mostra só os posts daquela tag (páginas /blog/tags/<tag>/).
import Base from '../../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { getLocale, localePath, t } from '../../i18n/ui';
import { allTags, getPosts, tagHref, tagSlug } from '../../lib/posts';

interface Props {
  tag?: string;
}

const { tag } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const all = await getPosts(locale);
const posts = tag ? all.filter((p) => p.data.tags.some((x) => tagSlug(x) === tagSlug(tag))) : all;
const [first, ...rest] = posts;
const tags = allTags(all);
const rss = localePath(locale, '/blog/index.xml');

const title = tag ? `#${tag} | ${t(locale, 'blog.metaTitle')}` : t(locale, 'blog.metaTitle');
---

<Base title={title} description={t(locale, 'blog.description')}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Thneppel Blog" href={rss} />

  <section class="blog">
    <header class="container head">
      <span class="eyebrow">{t(locale, 'blog.eyebrow')}</span>
      {
        tag ? (
          <h1 class="display-title">
            <span class="small">{t(locale, 'blog.tagged')}</span>
            <span class="accent">#{tag}</span>
          </h1>
        ) : (
          <h1 class="display-title">
            {t(locale, 'blog.title') && <>{t(locale, 'blog.title')} </>}
            <span class="accent">{t(locale, 'blog.titleAccent')}</span>
          </h1>
        )
      }
      {!tag && <p class="intro">{t(locale, 'blog.intro')}</p>}

      <nav class="tags" aria-label="Tags">
        <a href={localePath(locale, '/blog/')} aria-current={!tag ? 'page' : undefined}>
          {t(locale, 'blog.all')}
        </a>
        {
          tags.map((x) => (
            <a href={tagHref(x, locale)} aria-current={tag && tagSlug(x) === tagSlug(tag) ? 'page' : undefined}>
              #{x}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="container">
      {
        tag ? (
          <div class="grid">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          first && (
            <>
              <PostCard post={first} feature />
              {rest.length > 0 && (
                <div class="grid">
                  {rest.map((post) => (
                    <PostCard post={post} />
                  ))}
                </div>
              )}
            </>
          )
        )
      }

      <p class="rss">
        <a href={rss}>{t(locale, 'blog.rss')} ↗</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .blog {
    padding: clamp(3.5rem, 8vw, 6rem) 0 var(--section-pad);
    background: radial-gradient(60% 40% at 15% 0%, rgba(220, 15, 42, 0.1), transparent 70%), var(--bg);
  }

  .head {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .head .display-title {
    font-size: clamp(3rem, 9vw, 6.5rem);
  }

  /* No resto do site a parte vermelha do título quebra a linha; aqui fica na mesma */
  .head .display-title .accent {
    display: inline;
  }

  .small {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.35em;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
  }

  .intro {
    max-width: 44rem;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tags a {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .tags a:hover {
    border-color: var(--cream);
    color: var(--cream);
  }

  .tags a[aria-current] {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(3.5rem, 7vw, 5rem);
    padding-top: clamp(3rem, 6vw, 4rem);
    border-top: 1px solid var(--border);
  }

  /* Na página de tag não tem destaque em cima, então a grade começa direto */
  .container > .grid:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .rss {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .rss a:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
